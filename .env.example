# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=eacbot
EAC_BIND_ADDRESS=127.0.0.1
EAC_HTTP_PORT=8080
# Leave empty to use http://localhost:${EAC_HTTP_PORT:-8080}.
EAC_PUBLIC_URL=
# Leave empty to inherit EAC_PUBLIC_URL.
EAC_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set EAC_PUBLIC_URL to https:// followed by the same hostname.
# Requires EAC_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
EAC_HTTPS_HOST=
EAC_BASE_IMAGE=ghcr.io/milind-soni/eacbot:latest
EAC_LOCAL_IMAGE=eacbot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
EAC_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
EAC_DATA_EXTERNAL=false
