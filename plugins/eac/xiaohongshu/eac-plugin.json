{
  "schemaVersion": 1,
  "pluginId": "eac.xiaohongshu",
  "version": "2.0.0",
  "apiVersion": "^1.0.0",
  "name": "EAC 小红书内容台",
  "description": "小红书内容运营台：选题、素材、笔记草稿与发布计划（本地，稳定可用）；发布经由已登录的创作中心网页，按规则自动或逐项审批，全部动作留审计。数据回捞未开放，不做推断；遇验证码与风控一律暂停上报。",
  "publisher": "EACbot Community",
  "license": "Apache-2.0",
  "source": {
    "repository": "https://github.com/milind-soni/EACbot.git",
    "revision": "813bba63fd7aa94c98ecf6d93d43648abe50f3a9"
  },
  "compatibility": {
    "hostVersion": "^0.1.0 || >=0.2.0-preview.0 <0.3.0",
    "hosts": [
      "server",
      "desktop"
    ],
    "platforms": [
      "win32-x64",
      "linux-x64",
      "darwin-arm64",
      "darwin-x64"
    ]
  },
  "runtime": {
    "mode": "process",
    "entry": "entry.mjs",
    "isolation": "none"
  },
  "activation": [
    "manual"
  ],
  "permissions": [
    {
      "id": "xhs-read",
      "capability": "xiaohongshu.content.read",
      "effect": "read",
      "scope": {},
      "reason": "读取选题、素材、笔记草稿与计划。"
    },
    {
      "id": "xhs-write",
      "capability": "xiaohongshu.content.write",
      "effect": "write",
      "scope": {},
      "reason": "维护选题、素材、笔记草稿与发布计划。"
    },
    {
      "id": "xhs-delete",
      "capability": "xiaohongshu.content.delete",
      "effect": "delete",
      "scope": {},
      "reason": "删除选题、素材、笔记草稿与计划。"
    },
    {
      "id": "xhs-publish",
      "capability": "xiaohongshu.note.publish",
      "effect": "send",
      "scope": {},
      "reason": "在已登录的创作中心发布笔记，需主人单独授权。"
    }
  ],
  "contributes": {
    "platform": {
      "id": "xiaohongshu",
      "label": "小红书",
      "transports": [
        "web"
      ],
      "accountCapabilities": [
        "选题 / 素材 / 笔记草稿 / 发布计划（本地）",
        "发布笔记（按规则或逐项审批）",
        "笔记管理页数据读取"
      ]
    },
    "tools": [
      {
        "id": "xhs-idea",
        "entry": "entry.mjs",
        "effect": "write",
        "permission": "xhs-write",
        "description": "选题管理：action=add|list|delete（add 需要 title；list 支持 status 过滤）。"
      },
      {
        "id": "xhs-material",
        "entry": "entry.mjs",
        "effect": "write",
        "permission": "xhs-write",
        "description": "素材管理：action=add|list|delete（文本素材：title, body, tags?）。"
      },
      {
        "id": "xhs-note",
        "entry": "entry.mjs",
        "effect": "write",
        "permission": "xhs-write",
        "description": "笔记草稿：action=save|list|update|delete（title, body, tags?, status?）。"
      },
      {
        "id": "xhs-plan",
        "entry": "entry.mjs",
        "effect": "write",
        "permission": "xhs-write",
        "description": "发布计划：action=add|list|delete|done（noteId, plannedFor, note?）。提醒：这只是本机计划，不会自动发布。"
      },
      {
        "id": "xhs-publish",
        "entry": "entry.mjs",
        "effect": "send",
        "permission": "xhs-publish",
        "description": "发布一条笔记；规则为 manual 时进入待审批队列而不直接发布。"
      },
      {
        "id": "xhs-rules",
        "entry": "entry.mjs",
        "effect": "write",
        "permission": "xhs-write",
        "description": "设置发布模式（mode=auto|manual）。"
      },
      {
        "id": "xhs-bridge-status",
        "entry": "entry.mjs",
        "effect": "read",
        "permission": "xhs-read",
        "description": "报告网页线路状态、内容计数与发布模式。"
      }
    ]
  },
  "configSchema": "config.schema.json",
  "stateVersion": 2
}
