#!/bin/sh
exec node --input-type=module - "$1" <<'NODE'
import { readFileSync } from "node:fs";

const title = readFileSync(process.argv[2], "utf8").split(/\r?\n/, 1)[0];
const format = /^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^()\r\n]+\))?：\S.*$/;
if (!format.test(title) || !/\p{Script=Han}/u.test(title.split("：").slice(1).join("："))) {
  console.error("提交标题必须使用 类型(范围)：中文描述，范围可省略。");
  process.exitCode = 1;
}
NODE
