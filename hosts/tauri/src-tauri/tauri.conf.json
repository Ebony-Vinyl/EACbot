{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EACbot",
  "version": "0.1.0",
  "identifier": "app.eacbot.desktop",
  "build": {
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EACbot",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": false,
      "tooltip": "EACbot"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": []
  }
}
